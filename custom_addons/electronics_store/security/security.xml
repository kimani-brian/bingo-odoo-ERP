<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Module Category -->
    <record id="module_category_electronics_store" model="ir.module.category">
        <field name="name">Electronics Store</field>
        <field name="sequence">30</field>
    </record>

    <!-- Privileges -->
    <record id="privilege_electronics_admin" model="res.groups.privilege">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_electronics_store"/>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_electronics_sales" model="res.groups.privilege">
        <field name="name">Sales Officer</field>
        <field name="category_id" ref="module_category_electronics_store"/>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_electronics_inventory" model="res.groups.privilege">
        <field name="name">Inventory Officer</field>
        <field name="category_id" ref="module_category_electronics_store"/>
        <field name="sequence">30</field>
    </record>

    <!-- Groups -->
    <record id="group_electronics_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_electronics_admin"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_sales_officer" model="res.groups">
        <field name="name">Sales Officer</field>
        <field name="privilege_id" ref="privilege_electronics_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_inventory_officer" model="res.groups">
        <field name="name">Inventory Officer</field>
        <field name="privilege_id" ref="privilege_electronics_inventory"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('stock.group_stock_user'))]"/>
    </record>

</odoo>