<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- List View -->
    <record id="view_product_brand_list" model="ir.ui.view">
        <field name="name">electronics.product.brand.list</field>
        <field name="model">electronics.product.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="name"/>
                <field name="website"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_product_brand_form" model="ir.ui.view">
        <field name="name">electronics.product.brand.form</field>
        <field name="model">electronics.product.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="logo" widget="image"/>
                        <field name="website"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">electronics.product.brand</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>