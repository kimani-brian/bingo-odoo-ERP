<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record
        id="view_partner_form_electronics"
        model="ir.ui.view">

        <field name="name">res.partner.form.electronics</field>
        <field name="model">res.partner</field>

        <field name="inherit_id"
               ref="base.view_partner_form"/>

        <field name="arch" type="xml">

            <xpath expr="//notebook"
                   position="inside">

                <page string="Electronics Store">

                    <group>

                        <group>

                            <field name="customer_since"/>

                            <field name="national_id"/>

                            <field name="preferred_payment_method"/>

                        </group>

                        <group>

                            <field name="vip_customer"/>

                            <field name="credit_limit"/>

                            <field name="loyalty_points"/>

                        </group>

                    </group>

                </page>

            </xpath>

        </field>

    </record>

</odoo>