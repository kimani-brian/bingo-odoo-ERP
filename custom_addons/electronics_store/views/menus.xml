<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Root -->

    <menuitem
        id="menu_electronics_root"
        name="Electronics Store"
        sequence="10"
        web_icon="electronics_store,static/description/icon.png"
        groups="base.group_user"
    />

    <!-- Configuration (Admin & Inventory) -->

    <menuitem
        id="menu_configuration"
        name="Configuration"
        parent="menu_electronics_root"
        sequence="10"
        groups="electronics_store.group_electronics_admin,electronics_store.group_inventory_officer"
    />

    <menuitem
        id="menu_product_brand"
        name="Brands"
        parent="menu_configuration"
        action="action_product_brand"
        sequence="1"
    />

    <menuitem
        id="menu_warranty_plan"
        name="Warranty Plans"
        parent="menu_configuration"
        action="action_warranty_plan"
        sequence="2"
    />

    <!-- Sales (Sales Officer) -->

    <menuitem
        id="menu_sales"
        name="Sales"
        parent="menu_electronics_root"
        sequence="20"
        groups="electronics_store.group_sales_officer"
    />

    <menuitem
        id="menu_sales_brands"
        name="Brands"
        parent="menu_sales"
        action="action_product_brand"
        sequence="1"
    />

    <menuitem
        id="menu_sales_warranty"
        name="Warranty Plans"
        parent="menu_sales"
        action="action_warranty_plan"
        sequence="2"
    />

</odoo>