<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_generate_installment_invoices"
            model="ir.cron">

        <field name="name">
            Generate Due Installment Invoices
        </field>

        <field name="model_id"
               ref="model_electronics_installment"/>

        <field name="state">
            code
        </field>

        <field name="code">
            model.cron_generate_due_invoices()
        </field>

        <field name="interval_number">
            1
        </field>

        <field name="interval_type">
            days
        </field>

        <field name="active">
            True
        </field>

    </record>

    <record id="cron_sync_installment_payments"
        model="ir.cron">

        <field name="name">
            Synchronize Paid Installments
        </field>

        <field name="model_id"
            ref="model_electronics_installment"/>

        <field name="state">
            code
        </field>

        <field name="code">
            model.cron_sync_paid_installments()
        </field>

        <field name="interval_number">
            10
        </field>

        <field name="interval_type">
            minutes
        </field>

        <field name="active">
            True
        </field>

    </record>

</odoo>